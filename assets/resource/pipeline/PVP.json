{
    "PVPMain": {
        "desc": "玩家对战-入口：确保在主界面后进入对战",
        "next": [
            "PVP_Click:Exercise",
            "[JumpBack]AnySceneEnter_MainMenu"
        ]
    },
    "PVP_Click:Exercise": {
        "desc": "点击主界面-对战入口",
        "recognition": "And",
        "all_of": [
            "UI_MainMenu_exercise"
        ],
        "action": "Click",
        "post_delay": 2000,
        "next": [
            "PVP_Verify:BattleInterface"
        ]
    },
    "PVP_Verify:BattleInterface": {
        "desc": "确认已进入玩家对战界面",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "PVP/battle_interface.png"
                ],
                "roi": [
                    69,
                    611,
                    94,
                    86
                ],
                "threshold": 0.8
            }
        },
        "pre_delay": 500,
        "next": [
            "PVP_Do:InitBattleCount"
        ]
    },
    "PVP_Do:InitBattleCount": {
        "desc": "初始化战斗计数器",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "InitPVPBattleCount",
                "custom_action_param": {
                    "target_count": 1
                }
            }
        },
        "next": [
            "PVP_Select:Opponent"
        ]
    },
    "PVP_Select:Opponent": {
        "desc": "识别三个对手等级，选择等级最低的进行点击",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "SelectPVPOpponent",
                "custom_recognition_param": {
                    "rois": [
                        [
                            579,
                            276,
                            45,
                            27
                        ],
                        [
                            818,
                            276,
                            45,
                            28
                        ],
                        [
                            1055,
                            276,
                            45,
                            28
                        ]
                    ],
                    "click_positions": [
                        [
                            716,
                            578
                        ],
                        [
                            954,
                            577
                        ],
                        [
                            1191,
                            578
                        ]
                    ],
                    "only_rec": true
                }
            }
        },
        "pre_delay": 500,
        "action": "Click",
        "post_delay": 1000,
        "next": [
            "PVP_Check:ChallengeLimit",
            "PVP_Click:StartBattle"
        ]
    },
    "PVP_Check:ChallengeLimit": {
        "desc": "检测今日挑战次数是否用完（并列候选，命中则返回主页结束任务）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "PVP/challenge_limit.png"
                ],
                "roi": [
                    311,
                    85,
                    71,
                    77
                ],
                "threshold": 0.8
            }
        },
        "next": [
            "PVP_Click:MainMenu"
        ],
        "focus": {
            "Node.PipelineNode.Starting": {
                "content": "今日挑战次数已用完",
                "display": [
                    "log",
                    "toast"
                ]
            }
        }
    },
    "PVP_Click:StartBattle": {
        "desc": "点击开始战斗",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "PVP/start_battle.png"
                ],
                "roi": [
                    1048,
                    642,
                    158,
                    58
                ],
                "threshold": 0.8
            }
        },
        "pre_delay": 500,
        "action": "Click",
        "post_delay": 7000,
        "next": [
            "PVP_Click:BeginCombat"
        ]
    },
    "PVP_Click:BeginCombat": {
        "desc": "点击作战开始。timeout: 30000ms 覆盖长加载场景（loading 画面持续动画，无法 post_wait_freezes）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "PVP/begin_combat.png"
                ],
                "roi": [
                    896,
                    204,
                    249,
                    243
                ],
                "threshold": 0.8
            }
        },
        "pre_delay": 500,
        "action": "Click",
        "post_delay": 2000,
        "timeout": 30000,
        "next": [
            "PVP_Check:InBattle",
            "PVP_Click:BeginCombat"
        ]
    },
    "PVP_Check:InBattle": {
        "desc": "检测是否在战斗中（并列候选）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "PVP/in_battle.png"
                ],
                "roi": [
                    519,
                    585,
                    244,
                    113
                ],
                "threshold": 0.8
            }
        },
        "next": [
            "PVP_Click:Speed2x",
            "[JumpBack]PVP_Click:BeginCombat"
        ],
        "focus": {
            "Node.PipelineNode.Starting": {
                "content": "正在自动战斗中",
                "display": [
                    "log"
                ]
            }
        }
    },
    "PVP_Click:Speed2x": {
        "desc": "点击2倍速",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "PVP/speed_2x.png"
                ],
                "roi": [
                    1188,
                    27,
                    53,
                    52
                ],
                "threshold": 0.8
            }
        },
        "pre_delay": 500,
        "action": "Click",
        "next": [
            "PVP_Wait:BattleLoop"
        ]
    },
    "PVP_Wait:BattleLoop": {
        "desc": "战斗循环：等待战斗结束",
        "timeout": 300000,
        "next": [
            "PVP_Check:BattleEnd"
        ],
        "on_error": [
            "PVP_Read:Result"
        ]
    },
    "PVP_Check:BattleEnd": {
        "desc": "检测结算画面是否出现（OCR「跳过」，only_rec 直接识别 ROI 并点击）",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "跳过"
                ],
                "roi": [
                    1202,
                    34,
                    50,
                    26
                ],
                "only_rec": true,
                "threshold": 0.8
            }
        },
        "action": "Click",
        "next": [
            "PVP_Wait:Settlement"
        ]
    },
    "PVP_Wait:Settlement": {
        "desc": "等待结算动画播放完毕",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "PVP/exit_result.png"
                ],
                "threshold": 0.8
            }
        },
        "post_delay": 5000,
        "next": [
            "PVP_Read:Result"
        ]
    },
    "PVP_Read:Result": {
        "desc": "识别积分和排名（详情见日志）",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ReadPVPResult",
                "custom_recognition_param": {
                    "result_roi": [
                        62,
                        44,
                        189,
                        47
                    ],
                    "current_score_roi": [
                        78,
                        264,
                        92,
                        40
                    ],
                    "score_change_roi": [
                        190,
                        264,
                        50,
                        36
                    ],
                    "current_rank_roi": [
                        77,
                        352,
                        94,
                        35
                    ],
                    "rank_change_roi": [
                        175,
                        348,
                        73,
                        35
                    ]
                }
            }
        },
        "pre_delay": 5000,
        "next": [
            "PVP_Click:ExitResult"
        ],
        "focus": {
            "Node.PipelineNode.Starting": {
                "content": "PVP 战斗结束",
                "display": [
                    "log"
                ]
            }
        }
    },
    "PVP_Click:ExitResult": {
        "desc": "点击退出结果界面",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "PVP/exit_result.png"
                ],
                "threshold": 0.8
            }
        },
        "pre_delay": 500,
        "action": "Click",
        "post_delay": 1000,
        "next": [
            "[JumpBack]SceneDo_GetItem",
            "PVP_Verify:BackToBattleInterface"
        ]
    },
    "PVP_Verify:BackToBattleInterface": {
        "desc": "确认回到对战界面",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "PVP/battle_interface.png"
                ],
                "roi": [
                    69,
                    611,
                    94,
                    86
                ],
                "threshold": 0.8
            }
        },
        "pre_delay": 500,
        "next": [
            "PVP_Do:CheckBattleCount"
        ]
    },
    "PVP_Do:CheckBattleCount": {
        "desc": "检查剩余战斗次数",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "CheckPVPBattleCount"
            }
        },
        "next": [
            "PVP_Select:Opponent",
            "PVP_Click:MainMenu"
        ]
    },
    "PVP_Click:MainMenu": {
        "desc": "点击返回主页按钮（任务结束）",
        "recognition": "And",
        "all_of": [
            "UI_Common_HomeButton"
        ],
        "action": "Click",
        "post_delay": 1000,
        "next": [
            "PVP_End"
        ],
        "focus": {
            "Node.PipelineNode.Starting": {
                "content": "任务完成！",
                "display": [
                    "log"
                ]
            }
        }
    },
    "PVP_End": {
        "desc": "任务完成"
    },
    "PVP_TextFilter": {
        "desc": "玩家对战-积分/排名文本颜色遮罩（OCR color_filter 前置二值化）",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "method": 4,
                "lower": [
                    [
                        227,
                        71,
                        0
                    ],
                    [
                        225,
                        228,
                        61
                    ]
                ],
                "upper": [
                    [
                        255,
                        79,
                        14
                    ],
                    [
                        228,
                        231,
                        61
                    ]
                ],
                "connected": false,
                "count": 1000
            }
        }
    }
}
